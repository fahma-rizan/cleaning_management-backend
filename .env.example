# Backend environment example — copy to .env and fill with real values.
# NEVER commit your real .env file or secrets to source control.

# MongoDB connection (URI or SRV). URL-encode username/password if needed.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/your-db?retryWrites=true&w=majority

# JWT secret used to sign auth tokens
JWT_SECRET=your_long_random_jwt_secret_here

# Anthropic (AI assistant)
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY

# Email (use Gmail App Password for GMAIL_PASS)
GMAIL_USER=your.email@gmail.com
GMAIL_PASS=your_gmail_app_password

# Frontend URL used for links/redirects
FRONTEND_URL=http://localhost:3000

# PayHere (merchant + app credentials used for refunds and checkout)
PAYHERE_MERCHANT_ID=your_merchant_id
PAYHERE_MERCHANT_SECRET=your_merchant_secret
PAYHERE_APP_ID=your_app_id
PAYHERE_APP_SECRET=your_app_secret
PAYHERE_BASE_URL=https://sandbox.payhere.lk
PAYHERE_RETURN_URL=https://your-frontend/return
PAYHERE_CANCEL_URL=https://your-frontend/cancel
PAYHERE_NOTIFY_URL=https://your-backend/api/payhere/ipn

# Admin fallback values (optional)
ADMIN_EMAIL=admin@example.com
ADMIN_USER_ID=admin_user_id

# Dev convenience (only used when NODE_ENV=development)
DEV_USER_ID=dev_user_id
DEV_USER_EMAIL=dev@example.com

# Server controls
MONGO_CONNECT_RETRIES=5
PORT=4000
