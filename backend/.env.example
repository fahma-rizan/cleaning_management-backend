PORT=5000
NODE_ENV=development

# Frontend URL — comma-separate multiple origins for local dev (e.g. 3000,3001)
CLIENT_URL=http://localhost:3001

# MongoDB — use your Atlas URI in production
MONGO_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/your-db?appName=Cluster0


# JWT secrets — generate strong random strings (min 32 chars each)
JWT_ACCESS_SECRET=change-this-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-this-refresh-secret-min-32-chars

# Nodemailer (Gmail App Password — enable 2FA then create app password)
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password

# Google OAuth — create credentials at console.cloud.google.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Super admin seed (npm run seed:super-admin)
SEED_SUPER_ADMIN_EMAIL=superadmin@cloudlaundry.lk
SEED_SUPER_ADMIN_PASSWORD=SuperAdmin@1234
SEED_SUPER_ADMIN_NAME=Super Administrator

# General seed defaults
SEED_ADMIN_EMAIL=admin@cloudlaundry.lk
SEED_ADMIN_PASSWORD=Admin@1234
SEED_ADMIN_NAME=System Administrator
